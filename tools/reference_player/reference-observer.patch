+//! Investigation-only bounded, slot-only graph observer. Never execute game getters.
+use super::dynamic_map::DynamicKey;
+use super::property::Property;
+use super::{Object, TObject, Value};
+use crate::context::UpdateContext;
+use crate::display_object::{TDisplayObject, TDisplayObjectContainer};
+use serde_json::{json, Value as Json};
+use std::collections::{BTreeMap, HashSet, VecDeque};
+
+struct Walk<'gc> {
+    queue: VecDeque<(Object<'gc>, usize)>,
+    seen: HashSet<String>,
+    max_depth: usize,
+    max_objects: usize,
+    truncated: bool,
+}
+impl<'gc> Walk<'gc> {
+    fn value(&mut self, value: Value<'gc>, depth: usize) -> Json {
+        match value {
+            Value::Undefined => json!({"$undefined":true}),
+            Value::Null => Json::Null,
+            Value::Bool(v) => json!(v),
+            Value::Integer(v) => json!(v),
+            Value::Number(v) => serde_json::Number::from_f64(v).map(Json::Number)
+                .unwrap_or_else(|| json!({"$number":format!("{v}")})),
+            Value::String(v) => json!(v.to_utf8_lossy()),
+            Value::Object(object) => {
+                let id = format!("{:p}", object.as_ptr());
+                if !self.seen.contains(&id) {
+                    if depth <= self.max_depth && self.seen.len() < self.max_objects {
+                        self.seen.insert(id.clone());
+                        self.queue.push_back((object, depth));
+                    } else {
+                        self.truncated = true;
+                        return json!({"$ref":id,"$truncated":true});
+                    }
+                }
+                json!({"$ref":id})
+            }
+        }
+    }
+}
+
+pub(crate) fn snapshot(context: &mut UpdateContext<'_>, max_depth: usize, max_objects: usize) -> Json {
+    let mut walk = Walk {
+        queue: VecDeque::new(), seen: HashSet::new(),
+        max_depth: max_depth.min(32), max_objects: max_objects.clamp(1, 20000), truncated:false,
+    };
+    // Broadcast registration retains off-display-list GameEngine objects.
+    let mut roots: Vec<_> = context.avm2.broadcast_list.values().flatten()
+        .filter_map(|weak| weak.upgrade(context.gc()))
+        .filter(|object| object.instance_class().name().local_name().to_utf8_lossy() == "GameEngine")
+        .collect();
+    roots.extend(context.avm2.reference_games.iter().filter_map(|weak| weak.upgrade(context.gc())));
+    context.avm2.reference_games.retain(|weak| weak.upgrade(context.gc_context).is_some());
+    let roots: Vec<_> = roots.into_iter().map(|object| walk.value(object.into(), 0)).collect();
+    let mut nodes = BTreeMap::new();
+    while let Some((object, depth)) = walk.queue.pop_front() {
+        let id = format!("{:p}", object.as_ptr());
+        if object.instance_class().name().local_name().to_utf8_lossy() == "Game"
+            && !context.avm2.reference_games.iter().any(|weak| std::ptr::eq(weak.as_ptr(), object.as_ptr())) {
+            context.avm2.reference_games.push(object.downgrade());
+        }
+        let mut slots = Vec::new();
+        // Preserve namespace identity; do not assume same local name means same property.
+        for (name, namespace, property) in object.vtable().resolved_traits().iter() {
+            if let Property::Slot { slot_id } | Property::ConstSlot { slot_id } = *property {
+                slots.push(json!({"name":name.to_utf8_lossy(), "namespace":format!("{namespace:?}"),
+                    "slot":slot_id, "value":walk.value(object.get_slot(slot_id), depth+1)}));
+            }
+        }
+        slots.sort_by_key(|entry| (entry["name"].to_string(), entry["namespace"].to_string()));
+        let mut dynamic = Vec::new();
+        // Direct storage iteration does not change DynamicMap's Flash enumeration cursor.
+        for (key, property) in object.base().values().iter() {
+            let key = match *key {
+                DynamicKey::String(v) => json!({"string":v.to_utf8_lossy()}),
+                DynamicKey::Uint(v) => json!({"uint":v}),
+                DynamicKey::Object(v) => walk.value(v.into(), depth+1),
+            };
+            dynamic.push(json!({"key":key,"value":walk.value(property.value, depth+1),"enumerable":property.enumerable}));
+        }
+        let mut node = json!({"class":object.instance_of_class_name(context.gc()).to_utf8_lossy(),
+            "depth":depth,"slots":slots,"dynamic":dynamic});
+        if let Some(array) = object.as_array_object() {
+            let storage = array.storage();
+            node["array_length"] = json!(storage.length());
+            node["elements"] = Json::Array(storage.iter().take(1024).map(|v|
+                v.map(|v|walk.value(v,depth+1)).unwrap_or_else(||json!({"$hole":true}))).collect());
+            if storage.length()>1024 { walk.truncated=true; node["elements_truncated"]=json!(true); }
+        }
+        if let Some(function) = object.as_function_object() {
+            node["function"] = json!(function.executable().debug_full_name().to_utf8_lossy());
+            if let Some(receiver) = function.executable().reference_bound_receiver() {
+                node["receiver"] = walk.value(receiver,depth+1);
+            }
+        }
+        if let Some(display) = object.as_display_object() {
+            node["display"] = json!({"x":display.x().to_pixels(),"y":display.y().to_pixels()});
+            if let Some(movie) = display.as_movie_clip() {
+                node["display"]["current_frame"] = json!(movie.current_frame());
+            }
+            if let Some(container) = display.as_container() {
+                node["display"]["children"] = Json::Array(container.iter_render_list()
+                    .filter_map(|child|child.object2()).map(|child|walk.value(child.into(),depth+1)).collect());
+            }
+        }
+        nodes.insert(id,node);
+    }
+    json!({"schema":"bombit5-reference-graph-v1","roots":roots,"objects":nodes,"truncated":walk.truncated,
+        "limits":{"max_depth":walk.max_depth,"max_objects":walk.max_objects,"array_elements":1024},
+        "observation":"post-step native storage only; getters/methods not executed"})
+}
