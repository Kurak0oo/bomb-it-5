+// Snapshots are copied at actual method return, before later selectors mutate arrays.
+// No receiver is retained in State or Token and no AS getters are called.
+fn return_fields(v: Value<'_>, names: &[&str]) -> Json {
+    let Some(object)=v.as_object() else {return Json::Null;};
+    let mut fields=serde_json::Map::new();
+    for name in names {
+        let slots=object.vtable().resolved_traits().iter().filter_map(|(local,_,property)| {
+            if local.to_utf8_lossy()!=*name {return None;}
+            match *property {Property::Slot{slot_id}|Property::ConstSlot{slot_id}=>Some(slot_id),_=>None}
+        }).collect::<std::collections::BTreeSet<_>>();
+        let entry=if slots.len()==1 {return_value(object.get_slot(*slots.first().unwrap()),0)}
+            else {json!({"$unavailable":true,"distinct_slots":slots.len()})};
+        fields.insert((*name).into(),entry);
+    }
+    json!({"object":value(v,2),"fields":fields,"array_limit":128,"array_depth":3})
+}
+fn return_value(v: Value<'_>, depth: usize) -> Json {
+    if let Some(array)=v.as_object().and_then(|o|o.as_array_object()) {
+        let storage=array.storage();
+        return json!({"$ref":format!("{:p}",array.as_ptr()),"class":"Array",
+            "array_length":storage.length(),"array_truncated":storage.length()>128 || depth>=3,
+            "elements":if depth<3 {storage.iter().take(128).map(|entry|entry.map(|v|return_value(v,depth+1))
+                .unwrap_or_else(||json!({"$hole":true}))).collect::<Vec<_>>()} else {vec![]}});
+    }
+    value(v,2)
+}
