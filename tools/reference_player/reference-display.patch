+//! Research-only display-list dump for the comparison loop, and isolated piece renders.
+//! The dump reads native display state only: no ActionScript getters or methods run and
+//! nothing is written. `isolate` temporarily hides other display objects (native
+//! visibility flags only) so one piece renders alone; `restore` puts them back.
+use crate::avm2::TObject;
+use crate::context::UpdateContext;
+use crate::display_object::{
+    BoundsMode, DisplayObject, TDisplayObject, TDisplayObjectContainer, WindowMode,
+};
+use ruffle_render::matrix::Matrix;
+use serde_json::{json, Value as Json};
+
+const MAX_NODES: usize = 20000;
+const MAX_DEPTH: usize = 64;
+
+/// A stable path segment: the instance name, unless it is a Flash auto name
+/// (`instanceN`, whose N depends on creation order), in which case the depth. A name
+/// that several siblings share gets its depth appended (`name@depth`) to stay unique.
+fn segment(display: DisplayObject<'_>) -> String {
+    if let Some(name) = display.name() {
+        let name = name.to_utf8_lossy().into_owned();
+        let auto = name
+            .strip_prefix("instance")
+            .is_some_and(|rest| !rest.is_empty() && rest.bytes().all(|b| b.is_ascii_digit()));
+        if !name.is_empty() && !auto {
+            let shared = display.parent().is_some_and(|parent| {
+                children(parent).into_iter().filter(|s| {
+                    s.name().is_some_and(|n| n.to_utf8_lossy() == name.as_str())
+                }).count() > 1
+            });
+            return if shared { format!("{name}@{}", display.depth()) } else { name };
+        }
+    }
+    format!("@{}", display.depth())
+}
+
+fn kind(display: DisplayObject<'_>) -> &'static str {
+    if display.as_stage().is_some() {
+        "stage"
+    } else if display.as_movie_clip().is_some() {
+        "movie_clip"
+    } else if display.as_avm2_button().is_some() {
+        "button"
+    } else if display.as_edit_text().is_some() {
+        "text"
+    } else if display.as_bitmap().is_some() {
+        "bitmap"
+    } else if display.as_morph_shape().is_some() {
+        "morph_shape"
+    } else {
+        "graphic"
+    }
+}
+
+fn matrix(m: ruffle_render::matrix::Matrix) -> Json {
+    json!([m.a, m.b, m.c, m.d, m.tx.to_pixels(), m.ty.to_pixels()])
+}
+
+pub(crate) fn dump(context: &mut UpdateContext<'_>) -> Json {
+    let stage = context.stage;
+    let mut nodes = Vec::new();
+    let mut truncated = false;
+    let mut maskers = Vec::new();
+    let mut seen: Vec<(DisplayObject<'_>, String)> = Vec::new();
+    // Depth-first in render order, so `order` is the painter's order.
+    let mut todo: Vec<(DisplayObject<'_>, String, usize, bool)> = Vec::new();
+    for child in stage.iter_render_list().collect::<Vec<_>>().into_iter().rev() {
+        todo.push((child, String::new(), 0, true));
+    }
+    while let Some((display, parent, depth, parent_visible)) = todo.pop() {
+        if nodes.len() >= MAX_NODES || depth > MAX_DEPTH {
+            truncated = true;
+            break;
+        }
+        let path = if parent.ends_with("/@state") {
+            // The button's state child: its own segment is meaningless (not on a timeline).
+            parent.clone()
+        } else {
+            format!("{parent}/{}", segment(display))
+        };
+        let visible = display.visible();
+        let ct = display.base().color_transform();
+        let bounds = display.world_bounds(BoundsMode::Engine);
+        let mut node = json!({
+            "path": path,
+            "order": nodes.len(),
+            "kind": kind(display),
+            "name": display.name().map(|n| n.to_utf8_lossy().into_owned()),
+            "depth": display.depth(),
+            "character_id": display.id(),
+            "class": display.object2().map(|o| o.instance_of_class_name(context.gc()).to_utf8_lossy().into_owned()),
+            "visible": visible,
+            "effective_visible": parent_visible && visible,
+            "alpha": display.alpha(),
+            "color_transform": {
+                "mult": [ct.r_multiply.to_f64(), ct.g_multiply.to_f64(), ct.b_multiply.to_f64(), ct.a_multiply.to_f64()],
+                "add": [ct.r_add, ct.g_add, ct.b_add, ct.a_add],
+            },
+            "blend_mode": format!("{:?}", display.blend_mode()),
+            "filters": display.filters().len(),
+            "matrix": matrix(display.base().matrix()),
+            "stage_matrix": matrix(display.local_to_global_matrix()),
+            "stage_bounds": if bounds.is_valid() {
+                json!([bounds.x_min.to_pixels(), bounds.y_min.to_pixels(), bounds.x_max.to_pixels(), bounds.y_max.to_pixels()])
+            } else { Json::Null },
+        });
+        if display.clip_depth() > 0 {
+            node["clip_depth"] = json!(display.clip_depth());
+        }
+        if let Some(rect) = display.scroll_rect() {
+            node["scroll_rect"] = json!([rect.x_min.to_pixels(), rect.y_min.to_pixels(),
+                rect.width().to_pixels(), rect.height().to_pixels()]);
+        }
+        let render = display.render_bounds_with_transform(&display.local_to_global_matrix(), true, &Matrix::IDENTITY);
+        if render.is_valid() {
+            node["render_bounds"] = json!([render.x_min.to_pixels(), render.y_min.to_pixels(),
+                render.x_max.to_pixels(), render.y_max.to_pixels()]);
+        }
+        if let Some(masker) = display.masker() {
+            maskers.push((nodes.len(), masker));
+        }
+        if let Some(clip) = display.as_movie_clip() {
+            node["frame"] = json!(clip.current_frame());
+            node["total_frames"] = json!(clip.header_frames());
+            node["label"] = json!(clip.current_label().map(|(l, _)| l.to_utf8_lossy().into_owned()));
+        }
+        // A button draws one state child, which is not in a render list: walk it as
+        // `<button>/@state` so the art of the shown state is compared too.
+        let mut state_child = None;
+        if let Some(button) = display.as_avm2_button() {
+            let state = button.state();
+            node["button_state"] = json!(format!("{:?}", state).to_lowercase());
+            state_child = button.get_state_child(state.into());
+        }
+        if let Some(text) = display.as_edit_text() {
+            node["text"] = json!(text.text().to_utf8_lossy().into_owned());
+        }
+        seen.push((display, path.clone()));
+        nodes.push(node);
+        if let Some(container) = display.as_container() {
+            let children: Vec<_> = container.iter_render_list().collect();
+            for child in children.into_iter().rev() {
+                todo.push((child, path.clone(), depth + 1, parent_visible && visible));
+            }
+        }
+        if let Some(child) = state_child {
+            todo.push((child, format!("{path}/@state"), depth + 1, parent_visible && visible));
+        }
+    }
+    // An AS3 `mask` names another display object; record it by path.
+    for (index, masker) in maskers {
+        let path = seen.iter().find(|(d, _)| DisplayObject::ptr_eq(*d, masker)).map(|(_, p)| p.clone());
+        nodes[index]["mask"] = json!(path.unwrap_or_else(|| "(off the display list)".into()));
+    }
+    json!({
+        "schema": "bombit5-display-list-v1",
+        "stage": {"width": 700, "height": 510, "frame_rate": *context.frame_rate,
+            "background": stage.background_color().map(|c| json!([c.r, c.g, c.b, c.a]))},
+        "units": "stage pixels; matrix = [a, b, c, d, tx, ty]",
+        "truncated": truncated,
+        "nodes": nodes,
+    })
+}
+
+
+/// State to undo an `isolate`.
+pub struct ReferencePiece {
+    hidden: Vec<String>,
+    window_mode: WindowMode,
+    /// A piece that blends with what lies below renders with its own colours (Normal);
+    /// the consumer applies the blend against its own backdrop. Restored afterwards.
+    blend: Option<(String, ruffle_render::blend::ExtendedBlendMode)>,
+    /// Render bounds of the piece in stage units (filters included): x_min, y_min, x_max, y_max.
+    pub render_bounds: [f64; 4],
+    /// The same bounds in viewport pixels (through the stage view matrix, filters scaled
+    /// as the renderer scales them).
+    pub pixel_bounds: [f64; 4],
+}
+
+fn children(display: DisplayObject<'_>) -> Vec<DisplayObject<'_>> {
+    display.as_container().map(|c| c.iter_render_list().collect()).unwrap_or_default()
+}
+
+/// The chain of display objects from a stage child to `path`, using the dump's segments.
+fn resolve<'gc>(stage: DisplayObject<'gc>, path: &str) -> Option<Vec<DisplayObject<'gc>>> {
+    let mut chain = Vec::new();
+    let mut current = stage;
+    for part in path.split('/').skip(1) {
+        let next = if part == "@state" {
+            let button = current.as_avm2_button()?;
+            button.get_state_child(button.state().into())?
+        } else {
+            children(current).into_iter().find(|c| segment(*c) == part)?
+        };
+        chain.push(next);
+        current = next;
+    }
+    (!chain.is_empty()).then_some(chain)
+}
+
+/// Hide everything that would draw besides `path`, keeping the masks that clip it.
+pub(crate) fn isolate(context: &mut UpdateContext<'_>, path: &str) -> Result<ReferencePiece, String> {
+    let stage = context.stage;
+    let chain = resolve(stage.into(), path).ok_or_else(|| format!("no display object at {path}"))?;
+    let mut hidden = Vec::new();
+    let mut parent: DisplayObject<'_> = stage.into();
+    let mut parent_path = String::new();
+    for &node in &chain {
+        if parent.as_avm2_button().is_none() {
+            for sibling in children(parent) {
+                if DisplayObject::ptr_eq(sibling, node) || !sibling.visible() {
+                    continue;
+                }
+                let clips_node = sibling.clip_depth() > 0
+                    && sibling.depth() < node.depth()
+                    && sibling.clip_depth() >= node.depth();
+                let masks_node = node.masker().is_some_and(|m| DisplayObject::ptr_eq(m, sibling));
+                if clips_node || masks_node {
+                    continue;
+                }
+                // The native flag only: `set_visible` would also drop focus, a game-visible effect.
+                sibling.base().set_visible(false);
+                parent.invalidate_cached_bitmap();
+                hidden.push(format!("{parent_path}/{}", segment(sibling)));
+            }
+        }
+        parent_path = if parent.as_avm2_button().is_some() { format!("{parent_path}/@state") } else { format!("{parent_path}/{}", segment(node)) };
+        parent = node;
+    }
+    let target = *chain.last().unwrap();
+    let b = target.render_bounds_with_transform(&target.local_to_global_matrix(), true, &Matrix::IDENTITY);
+    let view = stage.view_matrix();
+    let p = target.render_bounds_with_transform(&(view * target.local_to_global_matrix()), true, &view);
+    let window_mode = stage.window_mode();
+    stage.set_window_mode(WindowMode::Transparent);
+    use ruffle_render::blend::ExtendedBlendMode;
+    let mode = target.blend_mode();
+    let blend = if mode != ExtendedBlendMode::Normal && mode != ExtendedBlendMode::Layer {
+        target.set_blend_mode(ExtendedBlendMode::Normal);
+        Some((path.to_string(), mode))
+    } else {
+        None
+    };
+    Ok(ReferencePiece {
+        hidden,
+        window_mode,
+        blend,
+        render_bounds: [b.x_min.to_pixels(), b.y_min.to_pixels(), b.x_max.to_pixels(), b.y_max.to_pixels()],
+        pixel_bounds: [p.x_min.to_pixels(), p.y_min.to_pixels(), p.x_max.to_pixels(), p.y_max.to_pixels()],
+    })
+}
+
+pub(crate) fn restore(context: &mut UpdateContext<'_>, piece: ReferencePiece) {
+    let stage = context.stage;
+    for path in &piece.hidden {
+        if let Some(chain) = resolve(stage.into(), path) {
+            let node = *chain.last().unwrap();
+            node.base().set_visible(true);
+            if let Some(parent) = node.parent() {
+                parent.invalidate_cached_bitmap();
+            }
+        }
+    }
+    stage.set_window_mode(piece.window_mode);
+    if let Some((path, mode)) = &piece.blend {
+        if let Some(chain) = resolve(stage.into(), path) {
+            chain.last().unwrap().set_blend_mode(*mode);
+        }
+    }
+}
