+/// The dump path of a display object (`@state` for a button's state child).
+pub(crate) fn path_of(display: DisplayObject<'_>) -> String {
+    let mut parts = Vec::new();
+    let mut current = display;
+    while let Some(parent) = current.parent() {
+        parts.push(if parent.as_avm2_button().is_some() { "@state".to_string() } else { segment(current) });
+        current = parent;
+    }
+    parts.reverse();
+    format!("/{}", parts.join("/"))
+}
